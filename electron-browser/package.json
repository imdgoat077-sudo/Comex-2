{
  "name": "sphere-browser",
  "version": "2.4.0",
  "description": "Sphere Workspace Browser Engine - A futuristic multi-agent browser with AI co-pilot capabilities",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "electron",
    "browser",
    "ai",
    "co-pilot",
    "workspace",
    "multi-agent"
  ],
  "author": "Sphere Workspace Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electronmon": "^2.0.0"
  },
  "build": {
    "appId": "com.sphere.workspace.browser",
    "productName": "Sphere Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
